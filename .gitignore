# python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# curve-generation scratch (MSes and tclean products are regenerable/huge;
# results/*.csv ARE tracked)
curvegen/ms/
curvegen/work/
TempLattice*/

# CASA droppings and simulation/imaging outputs (regenerable, can be huge)
casa-*.log
*.last
taperability-*/
*.ms/
*.psf/
*.image/
*.residual/
*.model/
*.pb/
*.sumwt/
curvegen/reports/

# claude-codex bridge
codex-bridge/tmp/
tmp/codex/

# user-local Claude Code permission grants (machine-specific)
.claude/settings.local.json
.claude/
# scratch symlinks (TACC): match the symlinks themselves, not just dir contents
curvegen/ms
curvegen/work
# per-(rev,sim_mode) campaign scratch dirs (ms-revD_track/, work-revF_snapshot/,
# ...): huge/regenerable, normally on $NGVLA_SCRATCH but ignore repo fallbacks
curvegen/ms-*/
curvegen/work-*/

# external delivery (contains nested git repos; see docs/architecture/mstroh_comparison.md)
mstroh/
._codex-bridge
# transient run logs and in-flight parallel shards (all rev/sim_mode results
# dirs: results/, results-revD_track/, results-revF_snapshot/, ...)
curvegen/results*/*.log
curvegen/results*/*.csv.shard_*
# PSF radial profiles are diagnostics, not curve data -- keep them out of git
curvegen/results*/profiles/
