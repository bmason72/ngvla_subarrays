\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Rev F subarrays in the current memo scope. Baselines are physical 3-D separations from the Rev F configuration files; for the uv-filtered long-baseline subarrays (\S  \ref {sec:curvegen}), $b_{\min }$ is the shortest baseline surviving the 178 m spurious-shorts cut. Native beam is the untapered natural-weighting geometric-mean FWHM at 30 GHz from the Rev F curve table. The LAS coefficient is the uniform adopted 18-m value, not a per-subarray measurement.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:subarrays}{{1}{4}{Rev F subarrays in the current memo scope. Baselines are physical 3-D separations from the Rev F configuration files; for the uv-filtered long-baseline subarrays (\S \ref {sec:curvegen}), $b_{\min }$ is the shortest baseline surviving the 178 m spurious-shorts cut. Native beam is the untapered natural-weighting geometric-mean FWHM at 30 GHz from the Rev F curve table. The LAS coefficient is the uniform adopted 18-m value, not a per-subarray measurement}{table.1}{}}
