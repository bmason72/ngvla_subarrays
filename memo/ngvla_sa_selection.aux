\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Point-source (taperability) envelopes at 30 GHz for the fourteen offered Rev F subarrays: minimum $\eta $ versus achievable geometric-mean beam, ignoring PSF shape. Left: the compact/core family; right: the long-baseline family (the panels intentionally do not share an x-axis). Curves are the engine's interpolated envelopes over the measured (robust, taper) lattice --- the same interpolation the selector uses --- clipped at each capped subarray's beam cap (\S  \ref {sec:beamcap}) and at the report's $\eta \le 5$ display trim; gaps are unmeasured stretches, not interpolation.}}{9}{figure.1}\protected@file@percent }
\newlabel{fig:taperability}{{1}{9}{Point-source (taperability) envelopes at 30 GHz for the fourteen offered Rev F subarrays: minimum $\eta $ versus achievable geometric-mean beam, ignoring PSF shape. Left: the compact/core family; right: the long-baseline family (the panels intentionally do not share an x-axis). Curves are the engine's interpolated envelopes over the measured (robust, taper) lattice --- the same interpolation the selector uses --- clipped at each capped subarray's beam cap (\S \ref {sec:beamcap}) and at the report's $\eta \le 5$ display trim; gaps are unmeasured stretches, not interpolation}{figure.1}{}}
