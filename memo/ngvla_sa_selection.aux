\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Point-source (taperability) envelopes at 30 GHz for the fourteen offered Rev F subarrays: minimum $\eta $ versus achievable geometric-mean beam, ignoring PSF shape. Left: the compact/core family; right: the long-baseline family (the panels intentionally do not share an x-axis). Curves are the engine's interpolated envelopes over the measured (robust, taper) lattice --- the same code path the selector uses --- clipped at each heterogeneous subarray's beam cap and at the report's $\eta \le 5$ display trim; gaps are unmeasured stretches, not interpolation.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:taperability}{{1}{6}{Point-source (taperability) envelopes at 30 GHz for the fourteen offered Rev F subarrays: minimum $\eta $ versus achievable geometric-mean beam, ignoring PSF shape. Left: the compact/core family; right: the long-baseline family (the panels intentionally do not share an x-axis). Curves are the engine's interpolated envelopes over the measured (robust, taper) lattice --- the same code path the selector uses --- clipped at each heterogeneous subarray's beam cap and at the report's $\eta \le 5$ display trim; gaps are unmeasured stretches, not interpolation}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Imaging (sculptability) envelopes for the same subarrays under the default threshold policy with $s_{\max }=0.10$ (panels as in Fig.~\ref {fig:taperability}). Solid: strict ($s \le 0.10$ achieved). Dashed: relaxed points whose best achievable skirt is $\le 0.25$ (the retired trade cap, kept here purely as a readability bucket). Dotted: relaxed points whose best achievable skirt exceeds $0.25$, concentrated near the finest resolutions of the long-containing composites. Five of those composites (mid+long, spiral+mid+long, main+long, mid+spiral+core-outer, long+mid+spiral+core-outer) never reach the strict threshold anywhere in their offered range.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:imaging}{{2}{7}{Imaging (sculptability) envelopes for the same subarrays under the default threshold policy with $s_{\max }=0.10$ (panels as in Fig.~\ref {fig:taperability}). Solid: strict ($s \le 0.10$ achieved). Dashed: relaxed points whose best achievable skirt is $\le 0.25$ (the retired trade cap, kept here purely as a readability bucket). Dotted: relaxed points whose best achievable skirt exceeds $0.25$, concentrated near the finest resolutions of the long-containing composites. Five of those composites (mid+long, spiral+mid+long, main+long, mid+spiral+core-outer, long+mid+spiral+core-outer) never reach the strict threshold anywhere in their offered range}{figure.2}{}}
