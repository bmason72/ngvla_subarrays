\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Imaging (sculptability) envelopes for the same subarrays under the default threshold policy with $s_0=0.10$ (panels as in Fig.~\ref {fig:taperability}). Solid: strict ($s \le 0.10$ achieved). Dashed: relaxed points whose best achievable skirt is $\le 0.25$ (a display category only; see Appendix~\ref {sec:history}). Dotted: relaxed points whose best achievable skirt exceeds $0.25$, concentrated near the finest resolutions of the long-containing composites. Five of those composites (mid+long, spiral+mid+long, main+long, mid+spiral+core-outer, long+mid+spiral+core-outer) never reach the strict threshold anywhere in their offered range.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:imaging}{{2}{10}{Imaging (sculptability) envelopes for the same subarrays under the default threshold policy with $s_0=0.10$ (panels as in Fig.~\ref {fig:taperability}). Solid: strict ($s \le 0.10$ achieved). Dashed: relaxed points whose best achievable skirt is $\le 0.25$ (a display category only; see Appendix~\ref {sec:history}). Dotted: relaxed points whose best achievable skirt exceeds $0.25$, concentrated near the finest resolutions of the long-containing composites. Five of those composites (mid+long, spiral+mid+long, main+long, mid+spiral+core-outer, long+mid+spiral+core-outer) never reach the strict threshold anywhere in their offered range}{figure.2}{}}
